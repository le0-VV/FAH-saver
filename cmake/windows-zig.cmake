# Run tools/bootstrap-windows.py first. The cache can be outside the checkout.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(FAH_WINDOWS_TOOLS "" CACHE PATH "Pinned tool cache from bootstrap-windows.py")
if(NOT FAH_WINDOWS_TOOLS)
    message(FATAL_ERROR "Set FAH_WINDOWS_TOOLS to the bootstrap-windows.py cache directory")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES FAH_WINDOWS_TOOLS)
foreach(tool zig-cxx zig-ar zig-ranlib zig-rc)
    if(NOT EXISTS "${FAH_WINDOWS_TOOLS}/bin/${tool}")
        message(FATAL_ERROR "Missing cross-build tool: ${FAH_WINDOWS_TOOLS}/bin/${tool}")
    endif()
endforeach()
set(CMAKE_CXX_COMPILER "${FAH_WINDOWS_TOOLS}/bin/zig-cxx")
set(CMAKE_AR "${FAH_WINDOWS_TOOLS}/bin/zig-ar")
set(CMAKE_RANLIB "${FAH_WINDOWS_TOOLS}/bin/zig-ranlib")
set(CMAKE_RC_COMPILER "${FAH_WINDOWS_TOOLS}/bin/zig-rc")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(Vulkan_INCLUDE_DIR "${FAH_WINDOWS_TOOLS}/Vulkan-Headers-1.4.363/include" CACHE PATH "Pinned Vulkan headers")
set(Vulkan_LIBRARY "${FAH_WINDOWS_TOOLS}/libvulkan-1.a" CACHE FILEPATH "Generated Vulkan import library")
